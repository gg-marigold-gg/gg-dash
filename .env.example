# Copy to .env.local for local testing. NEVER commit the real file.
# In production these go in Vercel: Project → Settings → Environment Variables.

# ---- Meta ----
# System user token from Business Manager. Needs the ads_read permission.
META_ACCESS_TOKEN=
# Optional: pin an API version. Check Meta's changelog for the current one.
META_API_VERSION=v21.0

# ---- Google Ads ----
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=v18

# ---- Behaviour ----
# How many days of history to pull on each sync.
LOOKBACK_DAYS=120
